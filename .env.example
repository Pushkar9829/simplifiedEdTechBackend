PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ibdp_tutoring
JWT_SECRET=ibdp_dev_jwt_secret_change_me
JWT_EXPIRES_IN=7d
DEMO_OTP=123456
OTP_EXPIRY_MINUTES=10
NODE_ENV=development
UPLOAD_DIR=uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
S3_KEY_PREFIX=ibdp

# Zoom Server-to-Server OAuth app. Leave blank for demo meeting links.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# SMS OTP for tutor references: msg91 | twilio. Leave blank to use DEMO_OTP.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Bank penny-drop verification and payouts: razorpay | cashfree. Leave blank for demo mode.
PAYOUT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://payout-gamma.cashfree.com

# AES key used to encrypt stored bank account numbers
BANK_ENCRYPTION_KEY=
